# Copy to .env and adjust. All values are read and validated at startup (apps/server/src/config.ts).

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# PostgreSQL. `npm run db:local` starts an embedded server matching this URL.
DATABASE_URL=postgres://postgres:aez_local_dev@localhost:5433/aez
DATABASE_POOL_MAX=20
# Only used by `npm run db:local`
LOCAL_PG_PORT=5433
LOCAL_PG_PASSWORD=aez_local_dev

# Browser origins allowed to call the API with cookies (comma separated). Must include the frontend origin.
WEB_ORIGINS=http://localhost:5173

# Set true behind a reverse proxy / load balancer (Render, Fly, Railway, nginx) so client IPs are correct.
TRUST_PROXY=false

# Session cookie. COOKIE_SECURE defaults to true when NODE_ENV=production. Keep it true for any HTTPS deployment.
COOKIE_SECURE=false
SESSION_COOKIE_NAME=aez_session
SESSION_TTL_HOURS=720
SESSION_IDLE_HOURS=168

RATE_LIMIT_ENABLED=true

# Competition rules: exactly $10,000.00 (enforced in production).
STARTING_CASH_CENTS=1000000
# Documented market-maker starting cash ($250,000.00). Shares are issued only when liquidity is opened.
MARKET_MAKER_STARTING_CASH_CENTS=25000000
MARKET_MAKER_USERNAME=aez_market_maker

# argon2id cost (OWASP baseline)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2

# Set true when running more than one backend instance (Socket.IO fan-out via Postgres).
SOCKET_IO_PG_ADAPTER=false
OUTBOX_POLL_MS=1000

# Optional: bootstrap admin created by `npm run db:seed` (only if it does not exist). Remove after first seed.
ADMIN_USERNAME=
ADMIN_PASSWORD=
